OKIMAP_ENVIRONMENT=production
OKIMAP_DATABASE_PATH=/var/lib/okimap-api/okimap.db
OKIMAP_FRONTEND_URL=https://okimap.wplaceoki.com/
OKIMAP_ALLOWED_ORIGINS=https://okimap.wplaceoki.com
OKIMAP_SECURE_COOKIES=true
OKIMAP_COOKIE_PATH=/api
OKIMAP_SESSION_SECRET=replace-with-at-least-32-random-characters
OKIMAP_ADMIN_DISCORD_IDS=123456789012345678,234567890123456789
DISCORD_CLIENT_ID=replace-me
DISCORD_CLIENT_SECRET=replace-me
DISCORD_REDIRECT_URI=https://okimap-api.wplaceoki.com/api/auth/discord/callback
